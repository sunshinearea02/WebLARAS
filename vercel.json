{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "echo 'Lewati npm install: tampilan memakai Tailwind/Chart.js/Leaflet dari CDN'",
    "buildCommand": "echo 'Lewati build front-end: Laravel dijalankan oleh runtime vercel-php'",
    "outputDirectory": "public",
    "regions": ["icn1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/", "dest": "/api/index.php" },
        { "src": "/index\\.php", "dest": "/api/index.php" },
        { "src": "/api/(.*)", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "id",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "LARAS_WA_LARAVEL": "false"
    }
}
