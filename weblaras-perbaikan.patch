diff --git a/tests/Feature/DashboardApiTest.php b/tests/Feature/DashboardApiTest.php
new file mode 100644
index 0000000..01fec69
--- /dev/null
+++ b/tests/Feature/DashboardApiTest.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\AiPrediction;
+use App\Models\SensorLog;
+use App\Models\SensorNode;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+/**
+ * Memastikan dashboard membaca vibration & confidence dari tabel ai_predictions
+ * (kolom tersebut tidak ada di sensor_data pada skema Supabase).
+ */
+class DashboardApiTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $node = SensorNode::create(['node_code' => 'NODE-01', 'node_name' => 'A', 'latitude' => -7.6, 'longitude' => 112.5]);
+        $log = SensorLog::create([
+            'node_id' => $node->id, 'timestamp' => now(), 'moisture_percent' => 55.5,
+            'pitch' => 1.2, 'roll' => 0.4, 'status' => 'AMAN', 'forecast_status' => null,
+        ]);
+        AiPrediction::create([
+            'sensor_data_id' => $log->id, 'rf_confidence' => 0.91, 'lstm_confidence' => 0.8,
+            'forecast_confidence' => 0.77, 'vibration' => 0.012, 'forecast_status' => 'WASPADA',
+        ]);
+    }
+
+    public function test_latest_sensor_includes_prediction_fields(): void
+    {
+        $this->getJson('/api/sensor-now')->assertOk()->assertJson([
+            'moisture_percent' => 55.5,
+            'rf_confidence' => 0.91,
+            'vibration' => 0.012,
+            'forecast_status' => 'WASPADA',
+        ]);
+    }
+
+    public function test_forecast_and_status_history_work(): void
+    {
+        $this->getJson('/api/forecast-history')->assertOk()
+            ->assertJsonPath('0.forecast_confidence', 0.77)
+            ->assertJsonPath('0.forecast_status', 'WASPADA');
+        $this->getJson('/api/status-history')->assertOk()->assertJsonPath('0.status_ai', 'AMAN');
+        $this->getJson('/api/sensor-since?last_id=0')->assertOk()->assertJsonCount(1);
+    }
+}
