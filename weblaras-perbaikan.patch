diff --git a/tests/Feature/RoleAccessTest.php b/tests/Feature/RoleAccessTest.php
new file mode 100644
index 0000000..8835abb
--- /dev/null
+++ b/tests/Feature/RoleAccessTest.php
@@ -0,0 +1,188 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\EvacuationCheckin;
+use App\Models\LandscapeAssessment;
+use App\Models\SensorNode;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class RoleAccessTest extends TestCase
+{
+    use RefreshDatabase;
+
+
+    private array $lanskap = [
+        'location_name' => 'Titik Sensor A',
+        'slope_classification' => 'Curam (25–45%)',
+        'artificial_slope_cutting' => 'ada',
+    ];
+
+    private SensorNode $node;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->node = SensorNode::create([
+            'node_code' => 'NODE-01', 'node_name' => 'Lereng Padusan',
+            'latitude' => -7.691, 'longitude' => 112.541,
+        ]);
+        $this->lanskap['node_id'] = $this->node->id;
+    }
+
+    private function makeEntry(string $name = 'Lokasi X'): LandscapeAssessment
+    {
+        return LandscapeAssessment::create([
+            'node_id' => $this->node->id,
+            'user_id' => User::factory()->create()->id,
+            'location_name' => $name,
+        ]);
+    }
+
+    private array $checkin = [
+        'posko_id' => 'Posko Kemiri',
+        'nama_lengkap' => 'Budi',
+        'asal' => 'Padusan RT 02',
+        'usia' => 40,
+        'kondisi' => 'Sehat',
+    ];
+
+    // ---------- Auth ----------
+
+    public function test_login_page_loads(): void
+    {
+        $this->get('/login')->assertOk()->assertSee('Login Kader');
+    }
+
+    public function test_kader_and_admin_can_login(): void
+    {
+        foreach (['kader', 'admin'] as $role) {
+            $user = User::factory()->create(['role' => $role, 'password' => 'secret123']);
+            $this->post('/login', ['email' => $user->email, 'password' => 'secret123'])
+                ->assertRedirect(route('lanskap.index'));
+            $this->assertAuthenticatedAs($user);
+            $this->post('/logout');
+        }
+    }
+
+    public function test_inactive_or_non_staff_cannot_login(): void
+    {
+        $inactive = User::factory()->create(['status' => 'INACTIVE', 'password' => 'secret123']);
+        $this->post('/login', ['email' => $inactive->email, 'password' => 'secret123'])->assertSessionHasErrors('email');
+        $this->assertGuest();
+
+    }
+
+    public function test_wrong_password_fails(): void
+    {
+        $user = User::factory()->create(['password' => 'secret123']);
+        $this->post('/login', ['email' => $user->email, 'password' => 'salah'])->assertSessionHasErrors('email');
+        $this->assertGuest();
+    }
+
+    public function test_only_admin_can_register_staff(): void
+    {
+        $this->get('/register')->assertRedirect(route('login'));
+        $this->actingAs(User::factory()->create())->get('/register')->assertForbidden();
+
+        $admin = User::factory()->admin()->create();
+        $this->actingAs($admin)->get('/register')->assertOk();
+        $this->actingAs($admin)->post('/register', [
+            'name' => 'Kader Baru', 'email' => 'kader@laras.id', 'role' => 'kader',
+            'password' => 'secret123', 'password_confirmation' => 'secret123',
+        ])->assertRedirect(route('register'));
+
+        $this->assertDatabaseHas('users', ['email' => 'kader@laras.id', 'role' => 'kader']);
+        $this->assertAuthenticatedAs($admin);
+    }
+
+    // ---------- Guest / Warga: hanya lihat ----------
+
+    public function test_guest_can_view_but_not_edit(): void
+    {
+        $entry = $this->makeEntry();
+
+        $this->get('/lanskap')->assertOk()
+            ->assertSee('Lokasi X')
+            ->assertSee('Warga (Guest)')
+            ->assertDontSee('Simpan Data Lanskap');
+
+        $this->get('/peta-evakuasi')->assertOk()->assertDontSee('Simpan Check-In Warga');
+        $this->get('/peta-evakuasi/checkins')->assertOk();
+
+        $this->post('/lanskap', $this->lanskap)->assertRedirect(route('login'));
+        $this->put("/lanskap/{$entry->id}", $this->lanskap)->assertRedirect(route('login'));
+        $this->delete("/lanskap/{$entry->id}")->assertRedirect(route('login'));
+        $this->postJson('/peta-evakuasi/checkin', $this->checkin)->assertUnauthorized();
+
+        $this->assertDatabaseCount('landscape_assessments', 1);
+        $this->assertDatabaseCount('evacuation_checkins', 0);
+    }
+
+    public function test_inactive_staff_is_forbidden(): void
+    {
+        $this->actingAs(User::factory()->create(['status' => 'INACTIVE']));
+        $this->post('/lanskap', $this->lanskap)->assertForbidden();
+        $this->postJson('/peta-evakuasi/checkin', $this->checkin)->assertForbidden();
+    }
+
+    // ---------- Admin & Kader: bisa edit ----------
+
+    public function test_staff_can_manage_landscape(): void
+    {
+        foreach (['kader', 'admin'] as $role) {
+            $staff = User::factory()->create(['role' => $role]);
+            $this->actingAs($staff);
+
+            $this->get('/lanskap')->assertOk()->assertSee('Simpan Data Lanskap')->assertSee('NODE-01');
+
+            $this->post('/lanskap', $this->lanskap)->assertRedirect(route('lanskap.index'))->assertSessionHasNoErrors();
+            $entry = LandscapeAssessment::latest('id')->first();
+            $this->assertTrue($entry->artificial_slope_cutting);
+            $this->assertSame($staff->id, $entry->user_id);
+            $this->assertSame($this->node->id, $entry->node_id);
+
+            $this->get("/lanskap?edit={$entry->id}")->assertOk()->assertSee('Simpan Perubahan');
+            $this->put("/lanskap/{$entry->id}", ['node_id' => $this->node->id, 'location_name' => 'Diubah', 'artificial_slope_cutting' => 'tidak_ada'])
+                ->assertRedirect(route('lanskap.index'));
+            $this->assertFalse($entry->fresh()->artificial_slope_cutting);
+            $this->assertSame('Diubah', $entry->fresh()->location_name);
+
+            $this->delete("/lanskap/{$entry->id}")->assertRedirect(route('lanskap.index'));
+            $this->assertModelMissing($entry);
+        }
+    }
+
+    public function test_landscape_rejects_invalid_option(): void
+    {
+        $this->actingAs(User::factory()->create());
+        $this->post('/lanskap', ['node_id' => $this->node->id, 'location_name' => 'A', 'soil_type' => 'ngawur'])->assertSessionHasErrors('soil_type');
+        $this->post('/lanskap', ['node_id' => 99999, 'location_name' => 'A'])->assertSessionHasErrors('node_id');
+    }
+
+    public function test_staff_can_checkin_and_delete(): void
+    {
+        foreach (['kader', 'admin'] as $role) {
+            $this->actingAs(User::factory()->create(['role' => $role]));
+            $this->get('/peta-evakuasi')->assertOk()->assertSee('Simpan Check-In Warga');
+
+            $res = $this->postJson('/peta-evakuasi/checkin', $this->checkin + ['lokasi_posko' => 'dipalsukan'])
+                ->assertOk()->assertJson(['success' => true]);
+
+            $checkin = EvacuationCheckin::find($res->json('data.id'));
+            $this->assertSame('Kawasan Pemukiman Desa Kemiri, Pacet', $checkin->lokasi_posko);
+
+            $this->deleteJson("/peta-evakuasi/checkin/{$checkin->id}")->assertOk();
+            $this->assertModelMissing($checkin);
+        }
+    }
+
+    public function test_checkin_rejects_unknown_posko(): void
+    {
+        $this->actingAs(User::factory()->create());
+        $this->postJson('/peta-evakuasi/checkin', ['posko_id' => 'Posko Palsu'] + $this->checkin)
+            ->assertUnprocessable()->assertJsonValidationErrors('posko_id');
+    }
+}
